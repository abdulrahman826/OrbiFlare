# === OrbiFlare environment configuration ===
# Copy to .env and adjust. Every value below has a safe local default,
# so the app runs fully offline/demo-mode with no keys set.

# --- Database ---
# Default: local SQLite file (zero setup). Swap for Postgres+PostGIS in production:
# DATABASE_URL=postgresql+psycopg://orbiflare:orbiflare@localhost:5432/orbiflare
DATABASE_URL=sqlite:///./data/orbiflare.db

# --- NASA FIRMS ingestion ---
# Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If unset, the app uses local demo fixtures instead of live FIRMS calls.
FIRMS_MAP_KEY=
FIRMS_API_BASE=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# --- App mode ---
# demo = seeded synthetic scenario labelled DEMO/SYNTHETIC
# real = ingested FIRMS + facility data drives the pipeline
ORBIFLARE_MODE=demo

# --- Event clustering ---
EVENT_SPATIAL_RADIUS_KM=1.5
EVENT_TEMPORAL_GAP_HOURS=12

# --- Thermal twin baseline ---
BASELINE_MIN_OBSERVATIONS_LIMITED=3
BASELINE_MIN_OBSERVATIONS_ESTABLISHED=8

# --- Risk thresholds (0-100 score -> severity) ---
RISK_THRESHOLD_MEDIUM=35
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80

# --- CORS / networking ---
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Agent ---
# The Fire Intelligence Agent is a deterministic, read-only intelligence
# agent: intent parsing + a controlled read-only tool registry over real
# stored data. No LLM/Claude is used and no key is required or accepted.
